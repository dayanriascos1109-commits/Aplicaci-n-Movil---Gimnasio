# Copia este archivo a .env y rellena los valores.
# .env NUNCA se versiona. Este archivo sí, y solo lleva valores de ejemplo.
#
# En Expo, únicamente las variables con prefijo EXPO_PUBLIC_ llegan a la app.
# Por eso aquí solo puede haber valores que NO sean secretos.
# Las claves privadas (API de IA, service_role de Supabase) viven exclusivamente
# en las Edge Functions del servidor. Un APK se descompila en dos minutos.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase — la anon key es pública por diseño; la seguridad la da RLS.
# Un proyecto de Supabase distinto por entorno.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo
